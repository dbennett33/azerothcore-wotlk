From 88de865416fb4710570c23bb2cd6b3025bc6ddfd Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Tue, 8 Sep 2026 19:20:57 +0000
Subject: [PATCH] feat(Rogue): add tricks-whisper combat strategy

Opt-in combat strategy that stops a rogue bot from spending
Tricks of the Trade on the tank so a player can whisper tricks
and get the buff instead. Other rogues keep tank ToT.

This overlay is a holding pen until the same commit can be pushed
to dbennett33/mod-playerbots (this agent has no write access there).
Delete this file once it lands on that repo's `dev` branch.
---
 src/Ai/Class/Rogue/RogueAiObjectContext.cpp   |  6 +++++
 .../Class/Rogue/Strategy/DpsRogueStrategy.cpp | 26 +++++++++++++++++++
 .../Class/Rogue/Strategy/DpsRogueStrategy.h   | 10 +++++++
 3 files changed, 42 insertions(+)

diff --git a/src/Ai/Class/Rogue/RogueAiObjectContext.cpp b/src/Ai/Class/Rogue/RogueAiObjectContext.cpp
index a2856c7..b781da9 100644
--- a/src/Ai/Class/Rogue/RogueAiObjectContext.cpp
+++ b/src/Ai/Class/Rogue/RogueAiObjectContext.cpp
@@ -30,6 +30,8 @@ public:
         creators["stealthed"] = &RogueStrategyFactoryInternal::stealthed;
         creators["stealth"] = &RogueStrategyFactoryInternal::stealth;
         creators["cc"] = &RogueStrategyFactoryInternal::cc;
+        creators["tricks-whisper"] =
+            &RogueStrategyFactoryInternal::tricks_whisper;
     }
 
 private:
@@ -40,6 +42,10 @@ private:
     static Strategy* stealthed(PlayerbotAI* botAI) { return new StealthedRogueStrategy(botAI); }
     static Strategy* stealth(PlayerbotAI* botAI) { return new StealthStrategy(botAI); }
     static Strategy* cc(PlayerbotAI* botAI) { return new RogueCcStrategy(botAI); }
+    static Strategy* tricks_whisper(PlayerbotAI* botAI)
+    {
+        return new TricksWhisperStrategy(botAI);
+    }
 };
 
 class RogueCombatStrategyFactoryInternal : public NamedObjectContext<Strategy>
diff --git a/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.cpp b/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.cpp
index 6bd6838..b164924 100644
--- a/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.cpp
+++ b/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.cpp
@@ -399,3 +399,29 @@ void RogueCcStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
         )
     );
 }
+
+class TricksWhisperTankMultiplier : public Multiplier
+{
+public:
+    TricksWhisperTankMultiplier(PlayerbotAI* botAI)
+        : Multiplier(botAI, "tricks whisper tank")
+    {
+    }
+
+    float GetValue(Action* action) override
+    {
+        if (!action)
+            return 1.0f;
+
+        if (action->getName() == "tricks of the trade on main tank")
+            return 0.0f;
+
+        return 1.0f;
+    }
+};
+
+void TricksWhisperStrategy::InitMultipliers(
+    std::vector<Multiplier*>& multipliers)
+{
+    multipliers.push_back(new TricksWhisperTankMultiplier(botAI));
+}
diff --git a/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.h b/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.h
index 71780a9..735db76 100644
--- a/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.h
+++ b/src/Ai/Class/Rogue/Strategy/DpsRogueStrategy.h
@@ -70,4 +70,14 @@ public:
     std::string const getName() override { return "cc"; }
 };
 
+// Holds Tricks of the Trade for a whisper request instead of the tank.
+class TricksWhisperStrategy : public Strategy
+{
+public:
+    TricksWhisperStrategy(PlayerbotAI* botAI) : Strategy(botAI) {}
+
+    void InitMultipliers(std::vector<Multiplier*>& multipliers) override;
+    std::string const getName() override { return "tricks-whisper"; }
+};
+
 #endif
-- 
