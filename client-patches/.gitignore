sources/client/mpq/*
!sources/client/mpq/.gitkeep

sources/client/loose/*
!sources/client/loose/.gitkeep

sources/server/dbc/*
!sources/server/dbc/.gitkeep

sources/server/maps/
sources/server/vmaps/
sources/server/mmaps/

# Local WoW client paths used during extraction
.wow-client-path

